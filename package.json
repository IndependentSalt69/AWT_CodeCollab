{
  "name": "codecollab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "jest --runInBand",
    "test:backend": "jest --runInBand testing/backend",
    "test:execution": "jest --runInBand testing/execution",
    "test:frontend": "jest --runInBand testing/frontend",
    "test:realtime": "jest --runInBand testing/realtime",
    "test:integration:mongo": "node testing/integration/run-mongo-integration.js",
    "build": "npm run build --workspace frontend",
    "start:backend": "npm run start --workspace=codecollab-backend",
    "start:worker": "node execution/worker/index.js",
    "dev:backend": "npm run dev --workspace=codecollab-backend",
    "dev:worker": "node execution/worker/index.js"
  },
  "description": "A full-stack web application that lets multiple users create shared coding rooms, communicate via real-time chat, and compile/execute code together in Python, Java, and C++ — all from the browser, with no third-party compiler APIs.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IndependentSalt69/AWT_CodeCollab.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "jest-environment-jsdom": "^30.5.2"
  }
}
