# =============================================================================
# CodeCollab M0.9 Environment Configuration Template (SEC-INFRA-01)
# Copy this file to '.env' and fill in secure values before starting services.
# NEVER commit real credentials, tokens, or passwords to source control.
# =============================================================================

# Server & Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Authentication (SEC-AUTH-01)
# Required: 256-bit cryptographically secure string (e.g. generate via `openssl rand -hex 32`)
# Startup will fail in production/staging if empty or set to known default.
JWT_SECRET=replace_with_a_cryptographically_secure_random_secret_at_least_32_bytes

# MongoDB Database Configuration (SEC-INFRA-01)
# Root administrative account (used only for initialization in docker-compose)
MONGO_ROOT_USER=admin_user
MONGO_ROOT_PASSWORD=replace_with_secure_mongo_admin_password

# Least-privilege application account restricted to the 'codecollab' database
MONGO_APP_USER=codecollab_app
MONGO_APP_PASSWORD=replace_with_secure_mongo_app_password
MONGO_URI=mongodb://codecollab_app:replace_with_secure_mongo_app_password@127.0.0.1:27017/codecollab?authSource=codecollab

# Redis Key-Value Store & BullMQ Execution Queue (SEC-INFRA-01)
REDIS_PASSWORD=replace_with_secure_redis_password
REDIS_URL=redis://:replace_with_secure_redis_password@127.0.0.1:6379/0

# Rate Limiting Controls (SEC-API-01)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_EXECUTE_MAX=20
RATE_LIMIT_JOIN_ROOM_MAX=10
RATE_LIMIT_VOICE_TOKEN_MAX=10

# Voice Channel (LiveKit)
# Leave empty to disable voice; POST /api/rooms/:roomId/voice-token then returns 503.
# Backend-only secrets: never expose LIVEKIT_API_SECRET to the frontend.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Opt-In Local Integration Testing (SEC-TEST-01)
# Set RUN_MONGO_INTEGRATION=true to run real MongoDB tests against a local instance.
# Safety guard: Integration runner rejects any remote or non-localhost URI.
RUN_MONGO_INTEGRATION=false
MONGO_TEST_URI=mongodb://127.0.0.1:27017/codecollab_test_disposable
