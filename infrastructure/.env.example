# =============================================================================
# CodeCollab M0.9 Infrastructure Environment Template (SEC-INFRA-01)
# Copy to 'infrastructure/.env' (or use root '.env') with your local credentials.
# NEVER commit real credentials, tokens, or passwords to source control.
# =============================================================================

PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:3000

JWT_SECRET=replace_with_a_cryptographically_secure_random_secret_at_least_32_bytes

MONGO_ROOT_USER=admin_user
MONGO_ROOT_PASSWORD=replace_with_secure_mongo_admin_password
MONGO_APP_USER=codecollab_app
MONGO_APP_PASSWORD=replace_with_secure_mongo_app_password

REDIS_PASSWORD=replace_with_secure_redis_password

RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_EXECUTE_MAX=20
RATE_LIMIT_JOIN_ROOM_MAX=10

# =============================================================================
# Execution Isolation Daemon & Runtime (M1.0 Phase B)
# =============================================================================
# Endpoint for isolated execution daemon (required for execution-worker):
#
# Option A (Local Compose Development - Bounded DinD profile):
#   DOCKER_HOST=tcp://execution-daemon:2375
#   Uses internal bridge 'execution-network'. Outer container bounded to 512MB/1 CPU.
#   Note: Per-runner cgroups are not enforced in this mode (CgroupDriver: none).
#
# Option B (Production - Dedicated Host-Level Rootless Daemon):
#   DOCKER_HOST=unix:///var/run/execution/docker.sock
#   Bind-mounted dedicated user socket (/run/user/1001/docker.sock owned by execution-user, chmod 0660).
#   WARNING: Do NOT instruct containerized workers to connect to 127.0.0.1 (loopback is container-scoped).
DOCKER_HOST=tcp://execution-daemon:2375

# Optional OCI container runtime (e.g. 'runsc' for gVisor, or empty/'runc' for standard)
# If set to 'runsc', the execution daemon MUST have gVisor installed and registered.
CONTAINER_RUNTIME=

# Require genuine kernel cgroup controller enforcement (CPU, Memory, PIDs).
# Automatically defaults to 'true' in production (fails closed if CgroupDriver is 'none').
# Set to 'false' for local development with the bounded DinD development profile.
REQUIRE_CGROUP_ENFORCEMENT=false

# Execution profile ('local-dev-execution' for trusted local DinD, or empty/'production' for standard):
# Required when using ALLOW_UNENFORCED_CGROUPS=true in development/test.
EXECUTION_PROFILE=local-dev-execution

# Development-only override allowing local testing against bounded DinD profile.
# SECURITY: Accepted ONLY when EXECUTION_PROFILE=local-dev-execution under NODE_ENV=development.
# Strictly REJECTED for production, staging, untrusted execution, and unknown modes.
ALLOW_UNENFORCED_CGROUPS=false
